# NavRUNA configuration. Copy to .env and fill in. Values with spaces or $ go in single quotes.
# Secrets live only here (or in the server's environment), never in the database.

# --- core
NAVRUNA_SECRET_KEY='replace-with-a-long-random-string-of-at-least-32-characters'
NAVRUNA_ADMIN_USERNAME=admin
NAVRUNA_ADMIN_PASSWORD='ChangeMe!2026x'      # first start only; you must change it at first sign-in
# NAVRUNA_DATA_DIR=/var/lib/navruna         # database, models, reports (default: ./data)
# NAVRUNA_DB_URL=postgresql+psycopg://navruna:secret@localhost/navruna   # default: SQLite in the data folder
NAVRUNA_PUBLIC_URL=http://navruna.airnav.local:8000   # used in alert links

# --- try without the AirNav network: synthetic flights, weather and sectors
NAVRUNA_DEMO=0

# --- NavTrace ADS-B database (read-only account)
NAVRUNA_NAVTRACE_DSN='host=172.20.25.30 port=25432 dbname=navtrace_flight user=navruna_ro password=CHANGE'
NAVRUNA_NAVTRACE_TABLE=navtrace.flight_trajectory

# --- NavEarth WFS (sectors, fixes)
NAVRUNA_NAVEARTH_WFS=https://app-pia.airnavindonesia.co.id/geoserver/enroute_chart/ows

# --- BMKG aviation weather (token from ksdip@bmkg.go.id)
NAVRUNA_BMKG_TOKEN=''

# --- alert channels (leave empty to switch a channel off)
NAVRUNA_SMTP_HOST=
NAVRUNA_SMTP_PORT=587
NAVRUNA_SMTP_USER=
NAVRUNA_SMTP_PASSWORD=
NAVRUNA_SMTP_FROM=navruna@airnavindonesia.co.id
NAVRUNA_ALERT_EMAILS=safety@airnavindonesia.co.id
NAVRUNA_WEBHOOK_URL=
NAVRUNA_WEBHOOK_SECRET=                      # adds an X-NavRUNA-Signature HMAC-SHA256 header
NAVRUNA_TELEGRAM_BOT_TOKEN=
NAVRUNA_TELEGRAM_CHAT_ID=

# --- scheduler (UTC)
NAVRUNA_SCHEDULER=1
NAVRUNA_DAILY_RUN_UTC=01:00
NAVRUNA_WX_POLL_MINUTES=30

# --- maps: leave empty on air-gapped servers (built-in coastline)
NAVRUNA_TILE_URL=
# NAVRUNA_REQUIRE_HTTPS=1                    # behind a TLS proxy: refuse plain HTTP
